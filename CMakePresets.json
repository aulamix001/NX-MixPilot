{
  "version": 3,
  "configurePresets": [
    {
      "name": "windows-x64",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/windows-x64"
    },
    {
      "name": "dsp-tests",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/dsp-tests",
      "cacheVariables": { "NX_BUILD_PLUGINS": "OFF", "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "windows-release", "configurePreset": "windows-x64", "configuration": "Release" },
    { "name": "dsp-tests", "configurePreset": "dsp-tests" }
  ],
  "testPresets": [
    { "name": "windows-release", "configurePreset": "windows-x64", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "dsp-tests", "configurePreset": "dsp-tests", "output": { "outputOnFailure": true } }
  ]
}
